---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  locale="en"
  title="Page not found · DiacriticS"
  description="The requested DiacriticS page could not be found."
  canonicalPath="/404"
  noindex={true}
>
  <Header locale="en" page="other" />
  <main id="main-content" class="not-found shell">
    <div class="not-found__mark" aria-hidden="true">ْ</div>
    <p class="eyebrow">404 · Not found</p>
    <h1>There is no word at this address.</h1>
    <p>The requested page does not exist. Return to the project or try the model.</p>
    <div class="not-found__actions">
      <a class="button button--primary" href="/">Return home</a>
      <a class="text-link" href="/demo/">Try the model</a>
    </div>
  </main>
  <Footer locale="en" />
</BaseLayout>
