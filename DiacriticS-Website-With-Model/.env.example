# Public canonical origin. Do not include a trailing slash.
PUBLIC_SITE_URL=http://localhost:4321

# Server-only inference configuration. Never prefix these with PUBLIC_.
DIACRITICS_GPU_ENDPOINT=https://<your-modal-app>.modal.run
DIACRITICS_GPU_TOKEN=
DIACRITICS_MODEL_LABEL=Qwen3.5-0.8B char tagger · full epoch
DIACRITICS_TIMEOUT_MS=60000
DIACRITICS_RATE_LIMIT=10

# Development fallback: curated | disabled | timeout | error
DIACRITICS_MOCK_MODE=disabled
