---
import { copy, routeFor, shared, type Locale } from "../content/site";
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
---

<section class="signature" data-signature aria-labelledby="hero-title">
  <img class="signature__media" src="/images/tashkeel-hero.svg" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" aria-hidden="true" />
  <div class="signature__veil" aria-hidden="true"></div>
  <div class="signature__sticky shell">
    <p class="eyebrow signature__eyebrow">{t.hero.eyebrow}</p>
    <div class="signature__stack" dir="rtl" lang="ar" aria-label={shared.heroArabic}>
      <span class="signature__full" aria-hidden="true">{shared.heroArabic}</span>
      <h1 class="signature__base" id="hero-title">{shared.heroBase}</h1>
    </div>
    <div class="signature__stack signature__stack--sub" dir="rtl" lang="ar" aria-label={shared.heroSubArabic}>
      <span class="signature__full" aria-hidden="true">{shared.heroSubArabic}</span>
      <p class="signature__base">{shared.heroSubBase}</p>
    </div>
    <p class="signature__caption">{t.hero.caption}</p>
    <p class="signature__brand" dir="ltr">{t.hero.brandLabel}</p>
    <p class="signature__support">{t.hero.support}</p>
    <p class="signature__note">{t.hero.note}</p>
    <div class="signature__actions">
      <a class="button button--primary" href="#idea">{t.hero.primary}<span aria-hidden="true"> ↓</span></a>
      <a class="text-link" href={routeFor(locale, "demo")}>{t.hero.try}</a>
    </div>
    <div class="signature__resources" aria-label={locale === "ar" ? "روابط المشروع" : "Project resources"}>
      {t.hero.resources.map((resource, index) => (
        "href" in resource && resource.href ? (
          <a class="resource-link" href={resource.href} target={"external" in resource && resource.external ? "_blank" : undefined} rel={"external" in resource && resource.external ? "noopener noreferrer" : undefined}>
            {index === 1 ? (
              <svg class="resource-link__icon" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            ) : (
              <svg class="resource-link__icon" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.15" d="M3.5 1.5h6l3 3v10h-9z"/><path fill="none" stroke="currentColor" stroke-width="1.15" d="M9.5 1.5v3h3"/><path fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" d="M5.3 8.2h5.4M5.3 10.2h5.4M5.3 12.2h3.2"/></svg>
            )}
            <span class="resource-link__text"><strong>{resource.label}</strong><span>{resource.meta}</span></span>
          </a>
        ) : (
          <span class="resource-link is-disabled" aria-disabled="true">
            <svg class="resource-link__icon" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.15" d="M3.5 1.5h6l3 3v10h-9z"/><path fill="none" stroke="currentColor" stroke-width="1.15" d="M9.5 1.5v3h3"/><path fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" d="M5.3 8.2h5.4M5.3 10.2h5.4M5.3 12.2h3.2"/></svg>
            <span class="resource-link__text"><strong>{resource.label}</strong><span>{resource.meta}</span></span>
          </span>
        )
      ))}
    </div>
    <p class="signature__credit">{t.media.hero.credit}</p>
  </div>
</section>

<script>
  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const scenes = Array.from(document.querySelectorAll<HTMLElement>("[data-signature]")).map((el) => ({ el, current: 0 }));
  let raf: number | null = null;

  function targetFor(el: HTMLElement) {
    const headerHeight = document.querySelector<HTMLElement>(".site-header")?.getBoundingClientRect().height || 0;
    const rect = el.getBoundingClientRect();
    const travel = Math.max(1, rect.height - window.innerHeight);
    const raw = (-rect.top + headerHeight) / travel;
    const linearProgress = clamp((raw - 0.02) / 0.82);
    return linearProgress * linearProgress * (3 - 2 * linearProgress);
  }

  function tick() {
    let stillMoving = false;
    for (const scene of scenes) {
      const target = targetFor(scene.el);
      const delta = target - scene.current;
      if (reduceMotion || Math.abs(delta) < 0.0006) {
        scene.current = target;
      } else {
        scene.current += delta * 0.13;
        stillMoving = true;
      }
      scene.el.style.setProperty("--reveal", `${scene.current * 112}%`);
      scene.el.style.setProperty("--progress", scene.current.toString());
    }
    raf = stillMoving ? requestAnimationFrame(tick) : null;
  }

  function scheduleUpdate() {
    if (raf === null) raf = requestAnimationFrame(tick);
  }

  scheduleUpdate();
  addEventListener("scroll", scheduleUpdate, { passive: true });
  addEventListener("resize", scheduleUpdate);
</script>
